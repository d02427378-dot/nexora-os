#!/bin/sh
set -eu

SOURCE_DIR=/usr/src/nexora
BUILD_DIR=/tmp/nexora-desktop-build
set -- build-essential cmake qt6-base-dev qt6-declarative-dev

if [ ! -f "$SOURCE_DIR/src/desktop/CMakeLists.txt" ]; then
    echo "Sources Nexora absentes du chroot: $SOURCE_DIR" >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install --yes --no-install-recommends "$@"
cmake -S "$SOURCE_DIR/src/desktop" -B "$BUILD_DIR" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
cmake --build "$BUILD_DIR" --target nexora-shell --parallel 2
cmake --install "$BUILD_DIR"

# Les sources et outils de compilation sont retirés du rootfs de l’image.
rm -rf -- "$BUILD_DIR" "$SOURCE_DIR"
apt-get purge --yes --auto-remove "$@"
rm -rf -- /var/lib/apt/lists/*
unset DEBIAN_FRONTEND
